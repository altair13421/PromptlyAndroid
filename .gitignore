# --- Built application files ---
*.apk
*.aar
*.ap_
*.aab

# --- Files for the ART/Dalvik VM ---
*.dex

# --- Java class files ---
*.class

# --- Generated files ---
bin/
gen/
out/
release/

# --- Gradle files ---
.gradle/
build/

# --- Local configuration file (sdk path, etc) ---
# IMPORTANT: local.properties contains your machine's SDK path — never commit
local.properties

# --- Proguard folder generated by Eclipse ---
proguard/

# --- Log Files ---
*.log

# --- Android Studio Navigation editor temp files ---
.navigation/

# --- Android Studio captures folder ---
captures/

# --- IntelliJ / Android Studio ---
*.iml
.idea/
# Keep the .idea code-style settings if you want to share them:
#!.idea/codeStyles/Project.xml
#!.idea/codeStyles/codeStyleConfig.xml

# --- Keystore files ---
# Uncomment the line below if you commit your debug keystore:
#!*.jks
# Uncomment the line below to keep debug.keystore for CI:
#!debug.keystore
*.jks
*.keystore
!debug.keystore

# --- External native build folder generated in Android Studio 2.2+ ---
.externalNativeBuild
.cxx/

# --- Google Services (e.g. APIs or Firebase) ---
google-services.json

# --- Freeline ---
freeline.py
freeline/
freeline_project_description.json

# --- fastlane ---
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# --- Version control ---
vcs.xml

# --- lint ---
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/

# --- AndroidX/Support library snapshot artifacts ---
support/

# --- Room schema export (optional — comment out if you want to track migrations) ---
# app/schemas/

# --- OS cruft ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*.swp
*~

# --- VSCode (if using VSCode for Kotlin) ---
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# --- Coverage reports ---
*.exec
coverage/
.espresso/

# --- Backup files ---
*.bak
*.orig

# --- KSP/KAPT generated sources ---
app/build/generated/ksp/
app/build/generated/kapt/

# --- Crashlytics ---
crashlytics-build.properties
com_crashlytics_export_strings.xml
*.salive
